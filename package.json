{
  "name": "vixer-web-llm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "node server/server.js",
    "start": "node server/server.js",
    "tunnel": "node server/fixedTunnel.js",
    "build": "vite build && node -e \"const fs=require('fs'); fs.copyFileSync('dist/index.html', 'index.html'); if (!fs.existsSync('assets')) fs.mkdirSync('assets'); fs.cpSync('dist/assets', 'assets', {recursive: true});\"",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.70",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "localtunnel": "^2.0.2",
    "vite": "^5.2.0"
  }
}
